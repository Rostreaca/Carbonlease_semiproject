<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.kh.openapi.main.model.dao.MainApiMapper">

    <select id="selectRegionCoords" resultType="KoreaRegionCoordVO">
        SELECT
               TOP_REGION_NAME  topRegionName
             , LATITUDE         latitude
             , LONGITUDE        longitude
        FROM 
               CL_REGION_COORD
    </select>

</mapper>
